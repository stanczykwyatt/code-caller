<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 (Windows 10 2004) is the first version that can keep a window out of screen captures. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CodeCaller</RootNamespace>
    <AssemblyName>CodeCaller</AssemblyName>
    <AssemblyTitle>Code Caller</AssemblyTitle>
    <ApplicationIcon>Assets\CodeCaller.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>

  <!-- Release builds for download: one self-contained .exe, nothing to install first. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms has its own Shortcut enum for menu keys; this app means its own global shortcuts. -->
    <Using Include="CodeCaller.Core.Settings.Shortcut" Alias="Shortcut" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\CodeCaller.ico" LogicalName="CodeCaller.Assets.CodeCaller.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeCaller.Core\CodeCaller.Core.csproj" />
  </ItemGroup>

</Project>
