<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Package advisories, or not being able to check for them, show up as warnings instead of breaking the build. -->
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- Lets the Windows app compile on macOS and Linux, so the whole solution builds anywhere. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
    <Authors>stanczykwyatt</Authors>
    <Product>Code Caller</Product>
    <Copyright>Copyright (c) 2026 stanczykwyatt</Copyright>
  </PropertyGroup>
</Project>
